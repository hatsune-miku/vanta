server {
    listen 80;
    listen [::]:80;
    server_name vanta.vanillacake.cn;
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }
    location / {
        return 301 https://vanta.vanillacake.cn$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name vanta.vanillacake.cn;
    ssl_certificate /etc/letsencrypt/live/vanta.vanillacake.cn/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vanta.vanillacake.cn/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    root /var/www/vanta;
    index index.html;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    location /assets/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }
    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache" always;
    }
}
